    {
      "name": "Get transactions by account",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Response has transactions array\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.have.property('transactions');",
              "    pm.expect(jsonData.transactions).to.be.an('array');",
              "});",
              "pm.test(\"Each transaction has required fields\", function () {",
              "    var jsonData = pm.response.json();",
              "    jsonData.transactions.forEach(function(tx) {",
              "        pm.expect(tx).to.have.property('id');",
              "        pm.expect(tx).to.have.property('accountId');",
              "        pm.expect(tx).to.have.property('amount');",
              "        pm.expect(tx).to.have.property('currency');",
              "        pm.expect(tx).to.have.property('direction');",
              "        pm.expect(tx).to.have.property('status');",
              "    });",
              "});",
              "pm.test(\"Direction is DEBIT or CREDIT\", function () {",
              "    var jsonData = pm.response.json();",
              "    jsonData.transactions.forEach(function(tx) {",
              "        pm.expect(['DEBIT', 'CREDIT']).to.include(tx.direction);",
              "    });",
              "});",
              "pm.test(\"Status is SUCCESS or FAILED\", function () {",
              "    var jsonData = pm.response.json();",
              "    jsonData.transactions.forEach(function(tx) {",
              "        pm.expect(['SUCCESS', 'FAILED']).to.include(tx.status);",
              "    });",
              "});",
              "pm.test(\"Currency is a valid value\", function () {",
              "    var jsonData = pm.response.json();",
              "    jsonData.transactions.forEach(function(tx) {",
              "        pm.expect(['EURO', 'GBP', 'USD', 'AUD']).to.include(tx.currency);",
              "    });",
              "});",
              "pm.test(\"Response time is less than 2000ms\", function () {",
              "    pm.expect(pm.response.responseTime).to.be.below(2000);",
              "});",
              "pm.test(\"Content-Type is application/json\", function () {",
              "    pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');",
              "});"
            ]
          }
        }
